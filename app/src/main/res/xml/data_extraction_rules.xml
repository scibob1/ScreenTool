<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- priv_cred.xml 存密码哈希/盐/恢复码/失败计数，不进云备份 -->
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="sharedpref" path="priv_cred.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="priv_cred.xml" />
    </device-transfer>
</data-extraction-rules>